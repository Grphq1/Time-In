NUXT_SESSION_PASSWORD=password-with-at-least-32-characters

# Server log level: Debug | Info | Warn | Error (default: Debug in dev, Info in prod)
NUXT_LOG_LEVEL=Info

NUXT_OAUTH_GITHUB_CLIENT_ID=your-github-client-id
NUXT_OAUTH_GITHUB_CLIENT_SECRET=your-github-client-secret
NUXT_OAUTH_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret

# Sentry runtime (safe to expose to the browser)
NUXT_PUBLIC_SENTRY_DSN=
NUXT_PUBLIC_SENTRY_ENVIRONMENT=development
NUXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NUXT_PUBLIC_SENTRY_RELEASE=

# Sentry build-time source map upload (never expose these to the client)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
